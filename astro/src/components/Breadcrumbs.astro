---
import { getGlobals } from '../utils/getGlobals';
import { getCategory } from '../utils/getCategories';
import { getCollection } from 'astro:content';

const { SITEURL, META_CATEGORY, PAGES_CATEGORY } = getGlobals();

const { frontmatter } = Astro.props;
const { title, category } = frontmatter;

let articleCategoryData, categoryId, catTitle;
if (category !== PAGES_CATEGORY && category !== META_CATEGORY) {
  if (!category) {
    throw `Category should not be ${category}. Make sure article ${title} is set up correctly`;
  }
  const categories = await getCollection('categories');
  articleCategoryData = await getCategory(categories, category);
  if(articleCategoryData) {
    categoryId = articleCategoryData.data.categoryId;
    catTitle = articleCategoryData.data.title;
  }
}
---
<div class="breadcrumb">
    <div class="breadcrumb-container">
        <div class="breadcrumb-links">
            <a href={SITEURL + "/"}>Главная</a>
            
            {/* Case 1: Simple page (e.g., /about.html) */}
            {category === PAGES_CATEGORY && category !== META_CATEGORY && (
                <>
                    <span class="breadcrumb-separator">»</span>
                    <span class="breadcrumb-current">{title}</span>
                </>
            )}
            
            {/* Case 2: Article within a category (e.g., /category/poems/article-title.html) */}
            {articleCategoryData && category !== PAGES_CATEGORY && category !== META_CATEGORY && (
                <>
                    <span class="breadcrumb-separator">»</span>
                    <a href={`${SITEURL}/category/${categoryId}.html`}>{catTitle}</a>
                    <span class="breadcrumb-separator">»</span>
                    <span class="breadcrumb-current">{title}</span>
                </>
            )}

            {/* Case 3: Category listing page (e.g., /category/poems.html) */}
            {/* This assumes 'title' prop will be the category title for these pages */}
            {/* And it's not a 'page' type, not a 'meta' category, and doesn't have articleCategoryData (which means it's not an article page) */}
            {category !== PAGES_CATEGORY && category !== META_CATEGORY && !articleCategoryData && (
                <>
                    <span class="breadcrumb-separator">»</span>
                    <span class="breadcrumb-current">{title}</span>
                </>
            )}
        </div>
    </div>
</div>

---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGlobals } from '../utils/getGlobals';

const { SITEURL } = getGlobals(); 
const { frontmatter } = Astro.props;
const { title } = frontmatter;
---
<BaseLayout title={title}>
  <Fragment slot="body">
    <nav class="main-nav">
        <div class="nav-container">
            <a href="#" class="nav-item">О поэте</a>
            <a href="#" class="nav-item active">Нетронутый Грааль</a>
            <a href="#" class="nav-item">Вино из грозди сердца</a>
            <a href="#" class="nav-item">Звенящая бессонница</a>
        </div>
    </nav>

    <Breadcrumbs
      frontmatter={frontmatter}
      SITEURL={SITEURL} 
    />

    <div class="content">
        <main>
          <article>
            {title && (<h1 class="page-title">{title}</h1>)}
            <slot name="content">Slot "content" not found</slot>
          </article>
        </main>
    </div>
  </Fragment>
</BaseLayout>
